# Multi-stage build for Web Frontend
# Stage 1: Build the React/Vite application
FROM node:lts-alpine AS builder

WORKDIR /app

# Copy package files for dependency installation
COPY web-frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy application source code
COPY web-frontend/ ./

# Accept build argument for API base URL
ARG VITE_BACKEND_URL=/api/v1
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

# Build the production-optimized static assets
RUN npm run build

# Stage 2: Serve static assets with Nginx
FROM nginx:alpine

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY deployment/dockerfiles/nginx.conf /etc/nginx/nginx.conf
COPY deployment/dockerfiles/nginx-https.conf.template /etc/nginx/nginx-https.conf.template
COPY deployment/dockerfiles/configure-https.sh /docker-entrypoint.d/30-configure-https.sh
RUN chmod +x /docker-entrypoint.d/30-configure-https.sh

# Expose HTTP and HTTPS ports
EXPOSE 80 443

# Start Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]
